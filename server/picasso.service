[Unit]
Description=PIC-ASS-O játékszerver
After=network-online.target
Wants=network-online.target

[Service]
User=picasso
WorkingDirectory=/opt/pic-ass-o/server
ExecStart=/usr/bin/node server.js
Environment=PORT=8787
Environment=DATA_DIR=/var/lib/picasso
# A WORDS_SECRET-et NE ide írd (ez a fájl a GitHubon van), hanem egy külön
# drop-in fájlba — lásd TELEPITES.md, „Szójelentések titkos kulcsa”.
# Melyik weboldalakról lehet csatlakozni (vesszővel). Alapból bármelyik *.netlify.app.
# Ha saját domainre teszed a játékot, írd ide is, pl.:
# Environment=ALLOWED_ORIGINS=https://pic-ass-o.netlify.app,*--pic-ass-o.netlify.app
# (v4.11: alapból is ez, csak a játék saját oldalai — más netlify.app oldal nem)
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/picasso
PrivateTmp=true

[Install]
WantedBy=multi-user.target
